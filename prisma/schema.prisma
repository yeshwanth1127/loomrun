generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  SALES
  TELECALLER
  PRODUCTION
  PRODUCTION_MANAGER
  VIEWER
}

enum LeadSource {
  WHATSAPP
  TELECALLER
  WEB
  INSTAGRAM
  REFERRAL
  OTHER
  META_ADS
  GOOGLE_ADS
  INDIAMART
  WEBSITE
  MANUAL
}

enum LeadStatus {
  ACTIVE
  WON
  LOST
  UNQUALIFIED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFICATION
  QUOTATION
  NEGOTIATION
  SAMPLE
  WON
  LOST
}

enum PipelineStageKind {
  OPEN
  WON
  LOST
}

enum PipelineType {
  GENERAL
  CAMPAIGN
  REGION
  PRODUCT
  SECTOR
  TEAM
  CUSTOM
}

enum LeadActivityType {
  NOTE
  STAGE_CHANGE
  ASSIGNMENT
  CALL
  WHATSAPP
  EMAIL
  SYSTEM
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DocumentType {
  QUOTATION
  INVOICE
}

enum ProductionStage {
  PENDING
  FABRIC_CHECK
  PROCUREMENT
  FABRIC_RECEIVED
  CUTTING
  PRINTING
  STITCHING
  QC
  PACKING
  PAYMENT_HOLD
  READY_DISPATCH
  SHIPPED
  DELIVERED
}

enum OrderStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum ProductionActivityType {
  ORDER_CREATED
  STAGE_CHANGED
  DELAY_TOGGLED
  PAYMENT_RECORDED
  EXPENSE_RECORDED
  BUDGET_SET
  NAME_CHANGED
  NOTE_ADDED
  STATUS_CHANGED
  ETA_UPDATED
  SHIPMENT_UPDATED
}

enum OutboundChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum OutboundMessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum WhatsAppTemplateCategory {
  QUOTATION
  INVOICE
  FOLLOW_UP
  THANK_YOU
  GREETING
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  NOT_INTERESTED
  CALLBACK_SCHEDULED
  QUALIFIED
  // Telecaller disposition codes (logged on call records; not shown on Leads board)
  CONNECTED_INTERESTED
  CONNECTED_NOT_INTERESTED
  RINGING_NO_RESPONSE
  SWITCHED_OFF
  ORDER_CONFIRMED
  // Canonical Call Status (client 2026-09) — keep legacy values above for old logs
  NOT_REACHABLE
  CALL_BACK_LATER
  WHATSAPP_SENT
  EMAIL_SENT
  FOLLOW_UP
  FOLLOW_UP_DATE_SET
  PHYSICAL_MEETING_REQUESTED
  PHYSICAL_MEETING_PENDING
  PHYSICAL_MEETING_DONE
  SAMPLE_REQUESTED
  SAMPLE_PRODUCTION_IN_PROGRESS
  SAMPLE_SENT
  FOLLOW_UP_AFTER_SAMPLE
  DEAL_WON_AFTER_SAMPLE
  DEAL_WON
  DEAL_REJECTED_AFTER_SAMPLE
  DEAL_LOST
  CLOSED_NOT_NOW
  DO_NOT_CONTACT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  isSuperAdmin  Boolean  @default(false) @map("is_super_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  qlixToolGrants     QlixToolGrant[]
  leadActivities     LeadActivity[]       @relation("LeadActivityActor")
  assignedLeads      Lead[]               @relation("LeadAssignee")
  telecallerCalls    TelecallerCallLog[]
  quotationsCreated     Quotation[]          @relation("QuotationAuthor")
  productionActivities  ProductionActivity[] @relation("ProductionActivityActor")
  expensesCreated       Expense[]            @relation("ExpenseCreator")
  aiPendingActions      AiPendingAction[]
  aiConversations       AiConversation[]

  @@map("users")
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  plan             String   @default("free")
  extraSeats       Int      @default(0) @map("extra_seats")
  trialEndsAt      DateTime? @map("trial_ends_at")
  suspended        Boolean  @default(false)
  stripeCustomerId String?  @map("stripe_customer_id")
  brandLogoUrl     String?  @map("brand_logo_url")
  brandSignatureUrl String? @map("brand_signature_url")
  brandUpiQrUrl    String?  @map("brand_upi_qr_url")
  brandLegalName   String?  @map("brand_legal_name")
  brandAddress     String?  @map("brand_address")
  brandPhone       String?  @map("brand_phone")
  brandEmail       String?  @map("brand_email")
  brandWebsite     String?  @map("brand_website")
  brandTaxId       String?  @map("brand_tax_id")
  brandBankName          String? @map("brand_bank_name")
  brandBankAccountNumber String? @map("brand_bank_account_number")
  brandBankAccountName   String? @map("brand_bank_account_name")
  brandBankIfsc          String? @map("brand_bank_ifsc")
  brandBankSwift         String? @map("brand_bank_swift")
  brandBankAdCode        String? @map("brand_bank_ad_code")
  brandBankBranch        String? @map("brand_bank_branch")
  defaultQuotationTemplateId String? @map("default_quotation_template_id")
  defaultInvoiceTemplateId   String? @map("default_invoice_template_id")
  autoGreetNewLeads Boolean @default(true) @map("auto_greet_new_leads")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships       Membership[]
  leads             Lead[]
  quotations        Quotation[]
  productionOrders  ProductionOrder[]
  payments          Payment[]
  subscriptions     Subscription[]
  whatsappThreads   WhatsAppThread[]
  whatsappConnections WhatsAppConnection[]
  whatsappTemplates WhatsAppTemplate[]
  outboundMessages  OutboundMessage[]
  telecallerCalls   TelecallerCallLog[]
  leadConnections      LeadConnection[]
  automationConnections AutomationConnection[]
  telephonyConfigs  TelephonyConfig[]
  telephonyUsages   TelephonyUsage[]
  catalogItems      CatalogItem[]
  documentTemplates DocumentTemplate[]
  productionActivities ProductionActivity[]
  expenses          Expense[]
  productionDesignAssets ProductionDesignAsset[]
  productionMockups ProductionMockup[]
  usageDaily        UsageDaily[]
  aiUsageWindows    AiUsageWindow[]
  aiUsageEvents     AiUsageEvent[]
  aiPendingActions  AiPendingAction[]
  aiOrgMemory       AiOrgMemory?
  aiConversations   AiConversation[]
  qlixConnection    QlixConnection?
  qlixSyncQueue     QlixSyncQueue[]
  qlixDocuments     QlixDocument[]
  qlixToolGrants    QlixToolGrant[]
  pipelines         Pipeline[]
  pipelineRoutingRules PipelineRoutingRule[]
  defaultQuotationTemplate DocumentTemplate? @relation("OrgDefaultQuotationTemplate", fields: [defaultQuotationTemplateId], references: [id], onDelete: SetNull)
  defaultInvoiceTemplate   DocumentTemplate? @relation("OrgDefaultInvoiceTemplate", fields: [defaultInvoiceTemplateId], references: [id], onDelete: SetNull)

  @@map("organizations")
}

model Pipeline {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  type           PipelineType @default(GENERAL)
  isDefault      Boolean      @default(false) @map("is_default")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]
  routingRules PipelineRoutingRule[]

  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@index([organizationId, isActive])
  @@map("pipelines")
}

model PipelineStage {
  id          String            @id @default(cuid())
  pipelineId  String            @map("pipeline_id")
  name        String
  slug        String
  sortOrder   Int               @default(0) @map("sort_order")
  kind        PipelineStageKind @default(OPEN)
  /// 0–100 win probability for weighted pipeline value (OPEN stages).
  probability Int?              @map("probability")
  /// Maps to LeadStage enum for call/quote automation hooks (NEW, CONTACTED, …).
  systemKey   String?           @map("system_key")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, sortOrder])
  @@index([pipelineId, systemKey])
  @@map("pipeline_stages")
}

model PipelineRoutingRule {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  pipelineId     String      @map("pipeline_id")
  priority       Int         @default(0)
  isActive       Boolean     @default(true) @map("is_active")
  /// Optional AND-match fields; null means "any". Exact-value matching only.
  source         LeadSource?
  campaignId     String?     @map("campaign_id")
  campaignName   String?     @map("campaign_name")
  region         String?
  productInterest String?    @map("product_interest")
  sector         String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([organizationId, priority])
  @@map("pipeline_routing_rules")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole @default(VIEWER)
  /// Personal WhatsApp number for callback reminders (org Baileys → this phone).
  whatsappPhone  String?        @map("whatsapp_phone")
  createdAt      DateTime       @default(now()) @map("created_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappConnections   WhatsAppConnection[]
  automationConnections AutomationConnection[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Lead {
  id               String      @id @default(cuid())
  organizationId   String      @map("organization_id")
  source           LeadSource  @default(OTHER)
  stage            LeadStage   @default(NEW)
  leadStatus       LeadStatus  @default(ACTIVE) @map("lead_status")
  pipelineId       String?     @map("pipeline_id")
  pipelineStageId  String?     @map("pipeline_stage_id")
  region           String?
  sector           String?
  /// Normalized campaign attribution (string IDs). Connectors mirror Meta/Google into these.
  campaignId       String?     @map("campaign_id")
  campaignName     String?     @map("campaign_name")
  title            String
  company          String?
  phone            String?
  email            String?
  city             String?
  sourceDetail     String?     @map("source_detail")
  productInterest  String?     @map("product_interest")
  quantityEstimate String?     @map("quantity_estimate")
  leadScore        Int         @default(0) @map("lead_score")
  tags             String[]
  notes            String?
  assigneeId       String?     @map("assignee_id")
  nextFollowUpAt   DateTime?   @map("next_follow_up_at")
  /// Set when an in-app due reminder was shown/acked for the current nextFollowUpAt.
  followUpRemindedAt DateTime? @map("follow_up_reminded_at")
  /// Set when a WhatsApp callback reminder was sent for the current nextFollowUpAt.
  followUpWaRemindedAt DateTime? @map("follow_up_wa_reminded_at")
  lastActivityAt   DateTime?   @map("last_activity_at")
  estimatedValue   Decimal?    @map("estimated_value") @db.Decimal(12, 2)
  metaLeadgenId    String?     @map("meta_leadgen_id")
  metaPageId       String?     @map("meta_page_id")
  metaFormId       String?     @map("meta_form_id")
  metaAdId         String?     @map("meta_ad_id")
  metaAdsetId      String?     @map("meta_adset_id")
  metaCampaignId   String?     @map("meta_campaign_id")
  metaCampaignName String?     @map("meta_campaign_name")
  metaAdsetName    String?     @map("meta_adset_name")
  metaAdName       String?     @map("meta_ad_name")
  metaFormName     String?     @map("meta_form_name")
  indiamartQueryId String?     @map("indiamart_query_id")
  googleAdsSubmissionId String? @map("google_ads_submission_id")
  googleAdsCustomerId   String? @map("google_ads_customer_id")
  googleAdsCampaignId   String? @map("google_ads_campaign_id")
  googleAdsCampaignName String? @map("google_ads_campaign_name")
  googleAdsFormId       String? @map("google_ads_form_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline      Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("LeadAssignee", fields: [assigneeId], references: [id])
  activities    LeadActivity[]
  quotations            Quotation[]
  productionOrders      ProductionOrder[]
  productionActivities  ProductionActivity[]
  threads       WhatsAppThread[]
  outbound      OutboundMessage[]
  calls         TelecallerCallLog[]
  expenses      Expense[]

  @@index([organizationId, stage])
  @@index([organizationId, pipelineId])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, campaignId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, metaCampaignId])
  @@index([organizationId, indiamartQueryId])
  @@index([organizationId, googleAdsSubmissionId])
  @@map("leads")
}

model LeadActivity {
  id        String             @id @default(cuid())
  leadId    String             @map("lead_id")
  userId    String?            @map("user_id")
  type      LeadActivityType   @default(NOTE)
  body      String
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation("LeadActivityActor", fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activities")
}

model Quotation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  leadId         String           @map("lead_id")
  authorId       String?          @map("author_id")
  number         String
  title          String?
  invoiceNumber  String?          @map("invoice_number")
  version        Int              @default(1)
  status         QuotationStatus  @default(DRAFT)
  pdfUrl         String?          @map("pdf_url")
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  tax            Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?        @map("sent_at")
  invoicedAt     DateTime?        @map("invoiced_at")
  pdfJobId       String?          @map("pdf_job_id")
  templateId     String?          @map("template_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User?        @relation("QuotationAuthor", fields: [authorId], references: [id])
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lines        QuotationLine[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("quotations")
}

model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String?      @map("organization_id")
  name           String
  slug           String
  docType        DocumentType @map("doc_type")
  isDefault      Boolean      @default(false) @map("is_default")
  isSystem       Boolean      @default(false) @map("is_system")
  layout         Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  orgsDefaultQuotation Organization[] @relation("OrgDefaultQuotationTemplate")
  orgsDefaultInvoice   Organization[] @relation("OrgDefaultInvoiceTemplate")

  @@unique([organizationId, slug, docType])
  @@index([organizationId, docType])
  @@map("document_templates")
}

model QuotationLine {
  id          String   @id @default(cuid())
  quotationId String   @map("quotation_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_lines")
}

model ProductionOrder {
  id                   String           @id @default(cuid())
  organizationId       String           @map("organization_id")
  leadId               String           @map("lead_id")
  quotationId          String?          @map("quotation_id")
  orderNumber          String           @map("order_number")
  name                 String?
  stage                ProductionStage  @default(PENDING)
  orderStatus          OrderStatus      @default(ON_TRACK) @map("order_status")
  delayFlag            Boolean          @default(false) @map("delay_flag")
  budgetCents          Int?             @map("budget_cents")
  expectedCompletionAt DateTime?        @map("expected_completion_at")
  expectedDispatchAt   DateTime?        @map("expected_dispatch_at")
  actualDispatchAt     DateTime?        @map("actual_dispatch_at")
  courierName          String?          @map("courier_name")
  courierTrackingNo    String?          @map("courier_tracking_no")
  shippingNotes        String?          @map("shipping_notes")
  onHoldReason         String?          @map("on_hold_reason")
  cancelledAt          DateTime?        @map("cancelled_at")
  trackingToken        String?          @unique @map("tracking_token")
  trackingEnabled      Boolean          @default(true) @map("tracking_enabled")
  stageEnteredAt       DateTime         @default(now()) @map("stage_entered_at")
  /// Design workspace: selected blank garment visualization (T_SHIRT, POLO_T_SHIRT, …)
  designGarmentType    String?          @map("design_garment_type")
  /// Design workspace: hex colour for default mockups, e.g. #1E3A5F
  designGarmentColor   String?          @map("design_garment_color")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotation    Quotation?   @relation(fields: [quotationId], references: [id])
  payments     Payment[]
  expenses     Expense[]
  activities   ProductionActivity[]
  designAssets ProductionDesignAsset[]
  mockups      ProductionMockup[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, stage])
  @@index([organizationId, orderStatus])
  @@index([leadId])
  @@map("production_orders")
}

model ProductionDesignAsset {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  productionOrderId String   @map("production_order_id")
  fileName          String   @map("file_name")
  storagePath       String   @map("storage_path")
  mimeType          String   @map("mime_type")
  byteSize          Int      @map("byte_size")
  /// SOURCE = customer tech-pack / reference; DESIGN = garment view for production
  kind              String   @default("SOURCE")
  /// FRONT | BACK | LEFT_SLEEVE | … — only meaningful for kind=DESIGN
  viewType          String?  @map("view_type")
  title             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  mockups         ProductionMockup[]

  @@index([productionOrderId])
  @@index([organizationId, productionOrderId])
  @@index([productionOrderId, kind])
  @@map("production_design_assets")
}

model ProductionMockup {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  productionOrderId String   @map("production_order_id")
  designAssetId     String   @map("design_asset_id")
  garmentType       String   @map("garment_type")
  view              String
  /// Normalized placement inside print area: { x, y, scale, rotation }
  placement         Json
  engine            String   @default("TEMPLATE_2D")
  status            String   @default("READY")
  storagePath       String?  @map("storage_path")
  lastError         String?  @map("last_error") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  designAsset     ProductionDesignAsset @relation(fields: [designAssetId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([designAssetId])
  @@index([organizationId, productionOrderId])
  @@map("production_mockups")
}

model Expense {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  productionOrderId String?         @map("production_order_id")
  leadId            String?         @map("lead_id")
  category          String
  subcategory       String?
  amountCents       Int             @map("amount_cents")
  description       String?
  vendor            String?
  incurredAt        DateTime        @default(now()) @map("incurred_at")
  createdById       String?         @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, incurredAt])
  @@index([productionOrderId])
  @@index([leadId])
  @@map("expenses")
}

model ProductionActivity {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  productionOrderId String                 @map("production_order_id")
  leadId            String                 @map("lead_id")
  userId            String?                @map("user_id")
  type              ProductionActivityType
  body              String
  metadata          Json?
  createdAt         DateTime               @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User?           @relation("ProductionActivityActor", fields: [userId], references: [id])

  @@index([organizationId, leadId, createdAt])
  @@index([productionOrderId, createdAt])
  @@map("production_activities")
}

model Payment {
  id                 String        @id @default(cuid())
  organizationId     String        @map("organization_id")
  productionOrderId  String        @map("production_order_id")
  amountCents        Int           @map("amount_cents")
  status             PaymentStatus @default(PENDING)
  note               String?
  recordedAt         DateTime      @default(now()) @map("recorded_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("payments")
}

model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  planKey              String    @map("plan_key")
  status               String    @default("inactive")
  currentPeriodEnd     DateTime? @map("current_period_end")
  seatCount            Int?      @map("seat_count")
  createdAt            DateTime  @default(now()) @map("created_at")
