/// One Qlix workspace per Loomrun org: agent + AI Brain + MCP tool binding.
/// Provisioned in one click; `credentials` holds the Fernet-encrypted qlix_live_* key.
model QlixConnection {
  id             String    @id @default(cuid())
  organizationId String    @unique @map("organization_id")
  /// disconnected | provisioning | connected | error
  status         String    @default("disconnected")
  /// Fernet blob: { "api_key": "qlix_live_..." }
  credentials    Json?
  qlixOrgId      String?   @map("qlix_org_id")
  agentId        String?   @map("agent_id")
  collectionId   String?   @map("collection_id")
  mcpServerId    String?   @map("mcp_server_id")
  /// Highest provisioning step completed, so a retry resumes instead of duplicating.
  provisionStep  String?   @map("provision_step")
  /// Backfill progress for the initial knowledge load.
  backfillState  Json?     @map("backfill_state")
  backfillDoneAt DateTime? @map("backfill_done_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastSweepAt    DateTime? @map("last_sweep_at")
  lastError      String?   @db.Text @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("qlix_connections")
}

/// Outbox of CRM records whose Brain document is stale.
/// Writes enqueue here instead of calling Qlix inline, so saving a lead never
/// waits on the network and a Qlix outage only backs the queue up.
model QlixSyncQueue {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  /// lead | quotation | production_order | catalog_item | expense | org_profile | team | pipeline | memory
  entityType     String    @map("entity_type")
  /// Record id, or a fixed key like "summary" for rollup documents.
  entityId       String    @map("entity_id")
  /// upsert | delete
  op             String    @default("upsert")
  /// pending | done | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?   @db.Text @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Coalescing key: re-marking a record already queued updates that row
  /// rather than adding a second push for the same change.
  @@unique([organizationId, entityType, entityId, status])
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("qlix_sync_queue")
}

/// A standing approval: once a user approves a write tool, the same tool runs
/// without asking again until this expires (24h), so routine work does not
/// re-prompt for every action. Revoking a row takes the permission back.
model QlixToolGrant {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Loomrun tool name, e.g. "create_lead".
  tool           String
  /// Who granted it — shown in the UI so an org can see who allowed what.
  userId         String?  @map("user_id")
  expiresAt      DateTime @map("expires_at")
  /// Counts how often the standing approval has been used, so the UI can show
  /// what it actually authorised rather than just that it exists.
  useCount       Int      @default(0) @map("use_count")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, tool])
  @@index([organizationId, expiresAt])
  @@map("qlix_tool_grants")
}

/// A document the user uploaded into their org's Brain (not auto-synced CRM records).
model QlixDocument {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  title          String
  fileName       String    @map("file_name")
  mimeType       String    @map("mime_type")
  sizeBytes      Int       @map("size_bytes")
  /// Relative path under settings.storage_dir, same convention as brand assets.
  storagePath    String    @map("storage_path")
  /// Qlix document id, once ingest has accepted it.
  qlixDocumentId String?   @map("qlix_document_id")
  externalId     String    @map("external_id")
  /// uploading | pending | ready | failed
  status         String    @default("uploading")
  lastError      String?   @db.Text @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, createdAt])
  @@map("qlix_documents")
}
