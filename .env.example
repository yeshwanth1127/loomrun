# Copy to `.env` at the repository root and adjust values for your environment.

DATABASE_URL="postgresql://postgres:ysw@localhost:5432/loomrun"
REDIS_URL="redis://localhost:6379/0"

# API
SECRET_KEY="change-me-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173"

# Local file storage for quotation PDFs when S3 not configured
STORAGE_DIR="./storage"

# WhatsApp Cloud API (optional; webhook still records inbound without token)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""

# Self-hosted Baileys WhatsApp sidecar (apps/whatsapp-baileys) — send from the org's own number
BAILEYS_SERVICE_URL="http://127.0.0.1:8090"
BAILEYS_SERVICE_SECRET=""

# Meta Lead Ads integration
META_APP_ID=""
META_APP_SECRET=""
# Optional: Facebook Login for Business → Configurations → Configuration ID
META_FB_LOGIN_CONFIG_ID=""
META_WEBHOOK_VERIFY_TOKEN="change-me-meta-webhook-verify-token"
# Public API URL (use ngrok URL when testing OAuth/webhooks locally)
PUBLIC_API_URL="http://localhost:8000"

# Google OAuth (Gmail, Calendar) + Google Ads lead forms
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# n8n automations (server-side — users never configure webhook URLs)
N8N_PUBLIC_URL="https://n8n.yourdomain.com"
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook"
N8N_API_URL="https://n8n.yourdomain.com"
N8N_API_KEY=""

# LLM for n8n automations (OpenRouter key stays on Loomrun; n8n uses LOOMRUN_AUTOMATION_API_KEY)
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
# Optional allowlist for AI chat dropdown (comma-separated). Form: id or id|Label
# OPENROUTER_CHAT_MODELS="openai/gpt-4o-mini|GPT-4o Mini,anthropic/claude-sonnet-4|Claude Sonnet 4"
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="Loomrun"

# Logging (INFO recommended in production). Set LOG_AI_MESSAGES=false to omit
# chat/prompt text from logs while still recording models, tokens, and latency.
LOG_LEVEL=INFO
LOG_AI_MESSAGES=true
LOOMRUN_AUTOMATION_API_KEY=""

# Subscription upgrade contact (admin assigns plans; users request upgrades via email)
SUBSCRIPTION_SUPPORT_EMAIL="support@loomrun.com"

# Platform-managed telephony (Twilio master account — never expose these to users)
# The platform owns one Twilio account; each org gets an auto-provisioned subaccount.
TWILIO_MASTER_ACCOUNT_SID=""
TWILIO_MASTER_AUTH_TOKEN=""
# Create an API Key under the master account: Console → Account → API Keys
TWILIO_MASTER_API_KEY_SID=""
TWILIO_MASTER_API_KEY_SECRET=""
# ISO country code for buying numbers (IN = India, US = United States, etc.)
TWILIO_NUMBER_COUNTRY="IN"

# VAPI master account (one account, per-org assistants + numbers)
VAPI_MASTER_API_KEY=""
# Set this in the VAPI dashboard → Webhooks → Server URL secret
VAPI_WEBHOOK_SECRET=""

# Billing markup applied to provider cost (1.5 = 50% markup)
TELEPHONY_MARKUP_MULTIPLIER=1.5

# Exotel master account (India click-to-call)
# SID, API Key, API Token → Exotel Dashboard → Developer Settings → API Settings
# Phone number → the ExoPhone virtual number you bought, e.g. +914066XXXXXX
EXOTEL_MASTER_SID=""
EXOTEL_MASTER_API_KEY=""
EXOTEL_MASTER_API_TOKEN=""
EXOTEL_MASTER_PHONE_NUMBER=""

# Comma-separated emails allowed for platform super-admin (login promotion,
# normal register if listed, and POST /v1/auth/register-super-admin).
SUPER_ADMIN_EMAILS=""

# ── Qlix (per-org AI agent, brain and CRM tools over MCP) ─────────────────────
# Register once with: apps/api/.venv/bin/python scripts/register-qlix-partner.py
# This key identifies Loomrun as a partner product; each org's own key is
# minted automatically when its owner clicks Activate agent.
QLIX_PARTNER_KEY=
QLIX_BASE_URL=https://qlix.exora.solutions/api/v1
# Public URL of this API's /mcp endpoint — Qlix calls it to run CRM tools.
# Without it an agent can answer questions but cannot act, so activation
# refuses to proceed until it is set.
QLIX_MCP_URL=
QLIX_DEFAULT_MODEL=openrouter/openai/gpt-4o-mini
# Signs the X-Loomrun-Context token Qlix forwards on each tool call.
# Falls back to SECRET_KEY when unset.
QLIX_CONTEXT_SECRET=

# Master switch for the Qlix-hosted agent. false = Loomrun runs its own
# in-process AI agent for every turn (the original in-house agent).
QLIX_ENABLED=true
