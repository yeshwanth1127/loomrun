{
  "name": "Loomrun Automations",
  "description": "Gmail read, send, read+send, and read+analyse workflows for per-org n8n provisioning.",
  "version": "1.0.0",
  "workflows": [
    {
      "key": "gmail-read",
      "has_webhook": false,
      "primary": false,
      "name": "Loomrun \u2014 Gmail Read",
      "nodes": [
        {
          "parameters": {
            "rule": {
              "interval": [
                {
                  "field": "minutes",
                  "minutesInterval": 30
                }
              ]
            }
          },
          "id": "a1b2c3d4-0001-4000-8000-000000000001",
          "name": "Every 30 minutes",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1.2,
          "position": [
            0,
            300
          ]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "getAll",
            "returnAll": false,
            "limit": 20,
            "filters": {
              "q": "is:unread in:inbox"
            },
            "options": {
              "downloadAttachments": false
            }
          },
          "id": "a1b2c3d4-0001-4000-8000-000000000002",
          "name": "Gmail \u2014 Get unread inbox",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2.1,
          "position": [
            260,
            300
          ],
          "credentials": {
            "gmailOAuth2": {
              "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
              "name": "Gmail \u2014 ORG_SLUG (replace per org)"
            }
          }
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "f1",
                  "name": "id",
                  "value": "={{ $json.id }}",
                  "type": "string"
                },
                {
                  "id": "f2",
                  "name": "from",
                  "value": "={{ $json.from }}",
                  "type": "string"
                },
                {
                  "id": "f3",
                  "name": "subject",
                  "value": "={{ $json.subject }}",
                  "type": "string"
                },
                {
                  "id": "f4",
                  "name": "snippet",
                  "value": "={{ $json.snippet }}",
                  "type": "string"
                },
                {
                  "id": "f5",
                  "name": "receivedAt",
                  "value": "={{ $json.date }}",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "a1b2c3d4-0001-4000-8000-000000000003",
          "name": "Normalize fields",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            520,
            300
          ]
        },
        {
          "parameters": {
            "content": "## Gmail Read only\n\nRuns on a schedule. Fetches unread inbox messages and outputs id, from, subject, snippet.\n\n**Next:** connect output to Slack, a database, or the Analyse workflow.",
            "height": 220,
            "width": 360
          },
          "id": "a1b2c3d4-0001-4000-8000-000000000004",
          "name": "Sticky Note",
          "type": "n8n-nodes-base.stickyNote",
          "typeVersion": 1,
          "position": [
            -40,
            80
          ]
        }
      ],
      "connections": {
        "Every 30 minutes": {
          "main": [
            [
              {
                "node": "Gmail \u2014 Get unread inbox",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Gmail \u2014 Get unread inbox": {
          "main": [
            [
              {
                "node": "Normalize fields",
                "type": "main",
                "index": 0
              }
            ]
          ]
        }
      },
      "settings": {
        "executionOrder": "v1"
      }
    },
    {
      "key": "gmail-send",
      "has_webhook": true,
      "primary": true,
      "name": "Loomrun \u2014 Gmail Send",
      "nodes": [
        {
          "parameters": {
            "httpMethod": "POST",
            "path": "loomrun-gmail-send",
            "responseMode": "onReceived",
            "options": {}
          },
          "id": "b1b2c3d4-0002-4000-8000-000000000001",
          "name": "Loomrun Webhook",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [
            0,
            300
          ],
          "webhookId": "loomrun-gmail-send"
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "strict"
              },
              "conditions": [
                {
                  "id": "c1",
                  "leftValue": "={{ $json.event }}",
                  "rightValue": "lead.created",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                },
                {
                  "id": "c2",
                  "leftValue": "={{ $json.data.lead.email }}",
                  "rightValue": "",
                  "operator": {
                    "type": "string",
                    "operation": "notEmpty"
                  }
                }
              ],
              "combinator": "and"
            },
            "options": {}
          },
          "id": "b1b2c3d4-0002-4000-8000-000000000002",
          "name": "New lead with email?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2.2,
          "position": [
            260,
            300
          ]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "s1",
                  "name": "to",
                  "value": "={{ $json.data.lead.email }}",
                  "type": "string"
                },
                {
                  "id": "s2",
                  "name": "leadName",
                  "value": "={{ $json.data.lead.title }}",
                  "type": "string"
                },
                {
                  "id": "s3",
                  "name": "orgName",
                  "value": "={{ $json.organization_name }}",
                  "type": "string"
                },
                {
                  "id": "s4",
                  "name": "subject",
                  "value": "=Thanks for contacting {{ $json.organization_name || 'us' }}",
                  "type": "string"
                },
                {
                  "id": "s5",
                  "name": "message",
                  "value": "=Hi {{ $json.data.lead.title }},\n\nThank you for your inquiry. Our team will review your request and get back to you shortly.\n\nBest regards,\n{{ $json.organization_name || 'Sales Team' }}",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "b1b2c3d4-0002-4000-8000-000000000003",
          "name": "Build email",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            520,
            220
          ]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "send",
            "sendTo": "={{ $json.to }}",
            "subject": "={{ $json.subject }}",
            "emailType": "text",
            "message": "={{ $json.message }}",
            "options": {}
          },
          "id": "b1b2c3d4-0002-4000-8000-000000000004",
          "name": "Gmail \u2014 Send",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2.1,
          "position": [
            780,
            220
          ],
          "credentials": {
            "gmailOAuth2": {
              "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
              "name": "Gmail \u2014 ORG_SLUG (replace per org)"
            }
          }
        },
        {
          "parameters": {
            "content": "## Gmail Send (per org)\n\n1. Rename webhook path to `loomrun-{org-slug}-send`\n2. Gmail credential = this org's inbox only\n3. Paste Production URL + sender email in Loomrun Integrations\n\nEmails send **from** the Google account on the Gmail credential.",
            "height": 200,
            "width": 380
          },
          "id": "b1b2c3d4-0002-4000-8000-000000000005",
          "name": "Sticky Note",
          "type": "n8n-nodes-base.stickyNote",
          "typeVersion": 1,
          "position": [
            -40,
            80
          ]
        }
      ],
      "connections": {
        "Loomrun Webhook": {
          "main": [
            [
              {
                "node": "New lead with email?",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "New lead with email?": {
          "main": [
            [
              {
                "node": "Build email",
                "type": "main",
                "index": 0
              }
            ],
            []
          ]
        },
        "Build email": {
          "main": [
            [
              {
                "node": "Gmail \u2014 Send",
                "type": "main",
                "index": 0
              }
            ]
          ]
        }
      },
      "settings": {
        "executionOrder": "v1"
      }
    },
    {
      "key": "gmail-read-send",
      "has_webhook": true,
      "primary": false,
      "name": "Loomrun \u2014 Gmail Read and Send",
      "nodes": [
        {
          "parameters": {
            "httpMethod": "POST",
            "path": "loomrun-gmail-read-send",
            "responseMode": "onReceived",
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000001",
          "name": "Loomrun Webhook",
          "type": "n8n-nodes-base.webhook",
          "typeVersion": 2,
          "position": [
            0,
            300
          ],
          "webhookId": "loomrun-gmail-read-send"
        },
        {
          "parameters": {
            "conditions": {
              "options": {
                "caseSensitive": true,
                "leftValue": "",
                "typeValidation": "strict"
              },
              "conditions": [
                {
                  "id": "c1",
                  "leftValue": "={{ $json.event }}",
                  "rightValue": "lead.stage_changed",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                },
                {
                  "id": "c2",
                  "leftValue": "={{ $json.data.to_stage }}",
                  "rightValue": "CONTACTED",
                  "operator": {
                    "type": "string",
                    "operation": "equals"
                  }
                },
                {
                  "id": "c3",
                  "leftValue": "={{ $json.data.lead.email }}",
                  "rightValue": "",
                  "operator": {
                    "type": "string",
                    "operation": "notEmpty"
                  }
                }
              ],
              "combinator": "and"
            },
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000002",
          "name": "Stage \u2192 Contacted?",
          "type": "n8n-nodes-base.if",
          "typeVersion": 2.2,
          "position": [
            260,
            300
          ]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "p1",
                  "name": "leadEmail",
                  "value": "={{ $json.data.lead.email }}",
                  "type": "string"
                },
                {
                  "id": "p2",
                  "name": "leadName",
                  "value": "={{ $json.data.lead.title }}",
                  "type": "string"
                },
                {
                  "id": "p3",
                  "name": "orgName",
                  "value": "={{ $json.organization_name }}",
                  "type": "string"
                },
                {
                  "id": "p4",
                  "name": "gmailQuery",
                  "value": "=from:{{ $json.data.lead.email }} newer_than:7d",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000003",
          "name": "Prepare lookup",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            520,
            220
          ]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "getAll",
            "returnAll": false,
            "limit": 5,
            "filters": {
              "q": "={{ $json.gmailQuery }}"
            },
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000004",
          "name": "Gmail \u2014 Read thread",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2.1,
          "position": [
            780,
            220
          ],
          "credentials": {
            "gmailOAuth2": {
              "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
              "name": "Gmail \u2014 ORG_SLUG (replace per org)"
            }
          },
          "alwaysOutputData": true
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "r1",
                  "name": "to",
                  "value": "={{ $('Prepare lookup').item.json.leadEmail }}",
                  "type": "string"
                },
                {
                  "id": "r2",
                  "name": "subject",
                  "value": "=Re: {{ $json.subject || 'Your inquiry' }}",
                  "type": "string"
                },
                {
                  "id": "r3",
                  "name": "message",
                  "value": "=Hi {{ $('Prepare lookup').item.json.leadName }},\n\nThanks for getting in touch. We received your message{{ $json.snippet ? ' regarding: ' + $json.snippet : '' }}.\n\nOur team will follow up with next steps shortly.\n\nBest regards,\n{{ $('Prepare lookup').item.json.orgName || 'Sales Team' }}",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000005",
          "name": "Build reply from context",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            1040,
            220
          ]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "send",
            "sendTo": "={{ $json.to }}",
            "subject": "={{ $json.subject }}",
            "emailType": "text",
            "message": "={{ $json.message }}",
            "options": {}
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000006",
          "name": "Gmail \u2014 Send reply",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2.1,
          "position": [
            1300,
            220
          ],
          "credentials": {
            "gmailOAuth2": {
              "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
              "name": "Gmail \u2014 ORG_SLUG (replace per org)"
            }
          }
        },
        {
          "parameters": {
            "content": "## Read then Send\n\n1. Loomrun fires `lead.stage_changed` \u2192 CONTACTED\n2. Reads recent emails **from** that lead\n3. Sends a contextual follow-up\n\nUse this webhook URL in Loomrun **instead of** the Send-only workflow (pick one primary webhook per org).",
            "height": 240,
            "width": 400
          },
          "id": "c1b2c3d4-0003-4000-8000-000000000007",
          "name": "Sticky Note",
          "type": "n8n-nodes-base.stickyNote",
          "typeVersion": 1,
          "position": [
            -40,
            60
          ]
        }
      ],
      "connections": {
        "Loomrun Webhook": {
          "main": [
            [
              {
                "node": "Stage \u2192 Contacted?",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Stage \u2192 Contacted?": {
          "main": [
            [
              {
                "node": "Prepare lookup",
                "type": "main",
                "index": 0
              }
            ],
            []
          ]
        },
        "Prepare lookup": {
          "main": [
            [
              {
                "node": "Gmail \u2014 Read thread",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Gmail \u2014 Read thread": {
          "main": [
            [
              {
                "node": "Build reply from context",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Build reply from context": {
          "main": [
            [
              {
                "node": "Gmail \u2014 Send reply",
                "type": "main",
                "index": 0
              }
            ]
          ]
        }
      },
      "settings": {
        "executionOrder": "v1"
      }
    },
    {
      "key": "gmail-read-analyse",
      "has_webhook": false,
      "primary": false,
      "name": "Loomrun \u2014 Gmail Read and Analyse",
      "nodes": [
        {
          "parameters": {
            "rule": {
              "interval": [
                {
                  "field": "minutes",
                  "minutesInterval": 15
                }
              ]
            }
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000001",
          "name": "Every 15 minutes",
          "type": "n8n-nodes-base.scheduleTrigger",
          "typeVersion": 1.2,
          "position": [
            0,
            300
          ]
        },
        {
          "parameters": {
            "resource": "message",
            "operation": "getAll",
            "returnAll": false,
            "limit": 10,
            "filters": {
              "q": "is:unread in:inbox -category:promotions"
            },
            "options": {}
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000002",
          "name": "Gmail \u2014 Get unread",
          "type": "n8n-nodes-base.gmail",
          "typeVersion": 2.1,
          "position": [
            260,
            300
          ],
          "credentials": {
            "gmailOAuth2": {
              "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
              "name": "Gmail \u2014 ORG_SLUG (replace per org)"
            }
          }
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "a1",
                  "name": "emailFrom",
                  "value": "={{ $json.from }}",
                  "type": "string"
                },
                {
                  "id": "a2",
                  "name": "emailSubject",
                  "value": "={{ $json.subject }}",
                  "type": "string"
                },
                {
                  "id": "a3",
                  "name": "emailBody",
                  "value": "={{ $json.snippet }}",
                  "type": "string"
                },
                {
                  "id": "a4",
                  "name": "analysisPrompt",
                  "value": "=You are a sales assistant for a manufacturing CRM.\n\nAnalyze this inbound email and respond in JSON only with keys:\n- intent (inquiry|follow_up|complaint|order|other)\n- urgency (low|medium|high)\n- summary (one sentence)\n- suggested_action (one sentence)\n- suggested_reply (short draft, or empty if none)\n\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nBody snippet: {{ $json.snippet }}",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000003",
          "name": "Prepare for AI",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            520,
            300
          ]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "https://loomrun.example.com/v1/automation/llm/chat",
            "authentication": "genericCredentialType",
            "genericAuthType": "httpHeaderAuth",
            "sendHeaders": true,
            "specifyHeaders": "keypair",
            "headerParameters": {
              "parameters": [
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={{ JSON.stringify({ prompt: $json.analysisPrompt, model: 'openai/gpt-4o-mini', temperature: 0.2, organization_slug: '__ORG_SLUG__' }) }}",
            "options": {}
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000004",
          "name": "Loomrun \u2014 LLM Analyse email",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.3,
          "position": [
            780,
            300
          ]
        },
        {
          "parameters": {
            "assignments": {
              "assignments": [
                {
                  "id": "o1",
                  "name": "from",
                  "value": "={{ $('Prepare for AI').item.json.emailFrom }}",
                  "type": "string"
                },
                {
                  "id": "o2",
                  "name": "subject",
                  "value": "={{ $('Prepare for AI').item.json.emailSubject }}",
                  "type": "string"
                },
                {
                  "id": "o3",
                  "name": "analysis",
                  "value": "={{ $json.content }}",
                  "type": "string"
                },
                {
                  "id": "o4",
                  "name": "analysedAt",
                  "value": "={{ $now.toISO() }}",
                  "type": "string"
                }
              ]
            },
            "options": {}
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000005",
          "name": "Structured output",
          "type": "n8n-nodes-base.set",
          "typeVersion": 3.4,
          "position": [
            1040,
            300
          ]
        },
        {
          "parameters": {
            "content": "## Read and Analyse\n\nRuns on schedule. For each unread email:\n1. Read from Gmail\n2. Analyse via Loomrun LLM API (OpenRouter)\n\n**Requires:** Gmail OAuth only. Clone via Loomrun Integrations — it injects URL, org slug, and the **Loomrun Automation API** credential.\n\nDo not import this JSON manually into n8n.",
            "height": 260,
            "width": 420
          },
          "id": "d1b2c3d4-0004-4000-8000-000000000006",
          "name": "Sticky Note",
          "type": "n8n-nodes-base.stickyNote",
          "typeVersion": 1,
          "position": [
            -40,
            60
          ]
        }
      ],
      "connections": {
        "Every 15 minutes": {
          "main": [
            [
              {
                "node": "Gmail \u2014 Get unread",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Gmail \u2014 Get unread": {
          "main": [
            [
              {
                "node": "Prepare for AI",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Prepare for AI": {
          "main": [
            [
              {
                "node": "Loomrun \u2014 LLM Analyse email",
                "type": "main",
                "index": 0
              }
            ]
          ]
        },
        "Loomrun \u2014 LLM Analyse email": {
          "main": [
            [
              {
                "node": "Structured output",
                "type": "main",
                "index": 0
              }
            ]
          ]
        }
      },
      "settings": {
        "executionOrder": "v1"
      }
    }
  ]
}
